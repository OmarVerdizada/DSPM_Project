# Sentro node profile: 32 GB RAM, 8-16 vCPU - console, workers and PostgreSQL on one host.
# Every figure is EXTRAPOLATED from docs/SCALING_ROADMAP_2026-10.md section 26.1;
# UNVERIFIED until the G2 gate has run on a host of this profile.

# PostgreSQL connections per process: scan work, console requests, heavy reads (W3.4).
DSPM_DB_POOL_MAX=12
DSPM_DB_POOL_MAX_API=10
DSPM_DB_POOL_MAX_HEAVY=3

# Scan memory follows one unit, not the estate (W3.1). Two units at once on this profile.
DSPM_PARTITION_MAX_FILES=2000
DSPM_PARTITION_MAX_BYTES=536870912
DSPM_PARTITION_WORKERS=2
# Detector processes: about 0.4 GiB each, 5 GB in the budget.
DSPM_DETECTOR_PROCESSES=10

# A scan pauses rather than fill the volume PostgreSQL writes its WAL to.
DSPM_MIN_FREE_DISK_MB=8192

# Storage stops growing (W3.5): the latest 3 completed scans of each name keep their rows.
DSPM_SCAN_RETENTION_PER_LABEL=3
