# =============================================================================
# Sentro DSPM - example environment configuration
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#
# NOTE: the application does NOT currently auto-load .env files. All settings
# are read with os.getenv(), so export these into the process environment (via
# your process manager, systemd unit, container env, or `set -a; . ./.env`).
# python-dotenv is declared in requirements.txt but is not wired up.
#
# Values shown are DEFAULTS unless marked REQUIRED IN PRODUCTION.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# "local" (default) or "production". Setting production enables fail-closed
# checks below, disables OpenAPI docs, blocks `--reload`, and denies scanning
# private/RFC1918 targets unless explicitly allowed.
DSPM_ENV=production

# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION - the app refuses to start without these
# -----------------------------------------------------------------------------
# JWT signing key, minimum 32 characters. In local mode a key is generated and
# persisted to data/.jwt_secret instead. Rotating this invalidates all tokens.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DSPM_SECRET_KEY=

# Password for the built-in `admin` account.
DSPM_ADMIN_PASSWORD=

# Credential-vault encryption key (PBKDF2-derived, Fernet). Losing this makes
# every stored scan credential unrecoverable - back it up before first run.
DSPM_VAULT_KEY=

# -----------------------------------------------------------------------------
# Network exposure
# -----------------------------------------------------------------------------
# Comma-separated allowed browser origins. Set this to your real console URL;
# leaving it empty in production means no cross-origin console access.
DSPM_CORS_ORIGINS=https://dspm.example.com

# Comma-separated Host header allowlist (TrustedHostMiddleware). Optional, but
# set it in production to block Host-header attacks.
DSPM_TRUSTED_HOSTS=dspm.example.com

# Machine-to-machine API keys, formatted tenant_id:hash
DSPM_API_KEYS=

# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------
# All default under ./data. In a container these MUST be on a persistent volume:
# the SQLite DB also backs login rate limiting, so an ephemeral filesystem
# silently resets brute-force protection on every restart.
DSPM_DB_PATH=data/dspm.sqlite
DSPM_INSIGHT_DB=data/insights.db
DSPM_REPORT_DIR=data/reports
DSPM_LOCAL_VAULT_KEY_PATH=

# Phase 1 read-switch (DATA-001). "1" serves list_findings from the normalized
# finding_index instead of loading report blobs; "0" (default) uses the blob.
# Parity-tested; any error falls back to the blob path automatically.
DSPM_READ_FROM_NORMALIZED=0

# -----------------------------------------------------------------------------
# Evidence integrity
# -----------------------------------------------------------------------------
# HMAC key for evidence fingerprints (SC-2, implemented). Production is now
# fail-closed: fingerprint generation raises if this is unset. In local/dev a
# per-install key is generated and persisted to data/.evidence_hmac_key. Set it
# explicitly in production.
DSPM_EVIDENCE_HMAC_KEY=

# Allow RAW, unmasked evidence previews (SC-1). Default "0" masks every detected
# sensitive class in previews and generic samples. Set to 1 ONLY for controlled
# local debugging - it lets raw secrets/PII back into previews, the DB and APIs.
DSPM_RAW_EVIDENCE_PREVIEW=0

# -----------------------------------------------------------------------------
# Scanning safety
# -----------------------------------------------------------------------------
# Require TLS for WinRM (SC-7). When unset, SSL is now required in production
# and cleartext HTTP 5985 + NTLM is tolerated only in local/dev. Set explicitly
# to "1" to always require SSL, or "0" to explicitly allow HTTP even in prod.
# NOTE: the endpoint-scan API currently only reaches HTTP, so requiring SSL in
# production fails those scans closed until an HTTPS endpoint is configured.
DSPM_REQUIRE_WINRM_SSL=1

# Allow WinRM auto-activation in production (SC-7). Activation opens an HTTP
# listener + firewall and enables DCOM/WMI on the target, so it is disabled in
# production by default. Set to 1 only for an explicit, audited admin workflow.
DSPM_ALLOW_WINRM_ACTIVATION=0

# Allow scanning private/RFC1918 targets. Default deny in production (SSRF
# guard). Set to 1 only if your scan targets are on internal networks.
DSPM_ALLOW_PRIVATE_TARGETS=0

# Wall-clock scan deadline in seconds (default 1800). NOTE: the deadline is
# measured, not enforced - a stuck worker is marked failed but not cancelled.
DSPM_SCAN_MAX_SECONDS=1800
DSPM_SCAN_HEARTBEAT_SECONDS=2
DSPM_TEXT_SCAN_MAX_BYTES=

# -----------------------------------------------------------------------------
# Authentication tuning
# -----------------------------------------------------------------------------
DSPM_TOKEN_TTL_SECONDS=3600
DSPM_LOGIN_MAX_ATTEMPTS=5
DSPM_LOGIN_WINDOW_SECONDS=300
DSPM_PBKDF2_ROUNDS=
DSPM_VAULT_KDF_ROUNDS=

# Salt for the vault key derivation. Set explicitly in production and keep it
# with DSPM_VAULT_KEY - changing either makes stored credentials unreadable.
DSPM_VAULT_SALT=

# Leave unset/0 in production. Re-syncs the built-in admin password from
# DSPM_ADMIN_PASSWORD at every startup, overwriting any rotation.
DSPM_SYNC_BUILTIN_ADMIN=0

# Leave unset/0. Enables verification of legacy unsalted SHA-256 password
# hashes; only turn on temporarily during a migration.
DSPM_ALLOW_LEGACY_SHA256_PASSWORDS=0

# Local-only convenience override. Ignored in production (DSPM_ADMIN_PASSWORD
# is required there). When unset, local installs fall back to a hardcoded
# default password - set this even for local pilots.
DSPM_DEV_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Job queue
# -----------------------------------------------------------------------------
DSPM_JOB_WORKERS=
DSPM_MAX_JOBS_TOTAL=
DSPM_MAX_JOBS_PER_TENANT=
DSPM_MAX_JOB_RESULT_FILES=
DSPM_JOB_RETENTION_SECONDS=

# -----------------------------------------------------------------------------
# Alerting
# -----------------------------------------------------------------------------
# Optional webhook POSTed on CRITICAL findings (backend/alerts.py).
# The variable name is DSPM_ALERT_WEBHOOK_URL - README previously documented
# this as DSPM_WEBHOOK_URL, which the code never reads.
DSPM_ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Copilot / LLM (local Ollama)
# -----------------------------------------------------------------------------
# Keep OLLAMA_HOST on localhost. Evidence context is not fully masked before
# the LLM call, so repointing this at a remote host ships scan metadata
# off-box. See docs/phase0_security_containment_analysis.md (SC-12).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=
OLLAMA_NUM_CTX=
OLLAMA_TEMPERATURE=
OLLAMA_MAX_CONCURRENT=

# Model selection and sampling. Leave unset to use the built-in defaults.
OLLAMA_MODEL_PROFILE=
OLLAMA_NUM_PREDICT=
OLLAMA_TOP_P=
OLLAMA_REPEAT_PENALTY=
OLLAMA_MODEL_HEALTH_TIMEOUT=
OLLAMA_MODEL_HEALTH_TTL_SECONDS=

# Leave unset in production - exposes additional copilot debug tooling.
COPILOT_ENABLE_DEBUG_TOOLS=0
COPILOT_SESSION_TTL_SECONDS=
COPILOT_SESSION_SWEEP_INTERVAL_SECONDS=
COPILOT_MAX_CONVERSATION_TURNS=
COPILOT_MAX_GENERAL_HISTORY_TURNS=
COPILOT_ARTIFACT_BASE_URL=
COPILOT_ARTIFACT_DL_TOKEN_TTL_SECONDS=

# Copilot token budgets and memory caps. Leave unset for built-in defaults.
COPILOT_MAX_TOKENS_CONTEXT=
COPILOT_MAX_TOKENS_CONVERSATION=
COPILOT_MAX_TOKENS_PER_TOOL=
COPILOT_MEMORY_MAX_BYTES=
COPILOT_MEMORY_MAX_LINES=
COPILOT_PLANNER_TIMEOUT=
COPILOT_PROVIDER_COOLDOWN_SECONDS=
COPILOT_FAST_VERBALIZER=
COPILOT_CONTROLLED_VERBALIZER=
COPILOT_CONTROLLED_VERBALIZER_TIMEOUT_MS=

# -----------------------------------------------------------------------------
# Detector timeouts / test switches
# -----------------------------------------------------------------------------
DSPM_GDPR_DETECTOR_TIMEOUT_SECONDS=
DSPM_NIST_DETECTOR_TIMEOUT_SECONDS=

# Dev-only: enables large/slow tests. Leave unset in production.
DSPM_RUN_LARGE_TESTS=0
