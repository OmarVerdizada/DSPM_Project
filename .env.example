# =============================================================================
# Sentro DSPM - example environment configuration
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.
#
# NOTE: the application does NOT currently auto-load .env files. All settings
# are read with os.getenv(), so export these into the process environment (via
# your process manager, systemd unit, container env, or `set -a; . ./.env`).
# python-dotenv is declared in requirements.txt but is not wired up.
#
# Values shown are DEFAULTS unless marked REQUIRED IN PRODUCTION.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# "local" (default) or "production". Setting production enables fail-closed
# checks below, disables OpenAPI docs, blocks `--reload`, and denies scanning
# private/RFC1918 targets unless explicitly allowed.
DSPM_ENV=production

# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION - the app refuses to start without these
# -----------------------------------------------------------------------------
# JWT signing key, minimum 32 characters. In local mode a key is generated and
# persisted OUTSIDE data/ (default ~/.dspm/jwt_secret, see DSPM_LOCAL_JWT_SECRET_PATH)
# so a data/ backup carries no signing key. Rotating this invalidates all tokens.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DSPM_SECRET_KEY=

# Password for the built-in `admin` account.
DSPM_ADMIN_PASSWORD=

# Credential-vault encryption key. M3: this must be a REAL 32-byte urlsafe-base64
# Fernet key (no passphrase/KDF); a short or malformed value fails at startup.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this makes every stored scan credential unrecoverable - back it up.
DSPM_VAULT_KEY=

# -----------------------------------------------------------------------------
# Network exposure (C5) - production serves on loopback behind an HTTPS reverse
# proxy on the same host; see deploy/reverse-proxy/README.md. Production REFUSES TO
# START with an empty or wildcard host list, a wildcard / local / http:// origin, an
# unreadable or 0.0.0.0/0 trusted proxy, a non-loopback `serve --host`, or a loopback
# one with no trusted proxy covering it.
# -----------------------------------------------------------------------------
# Comma-separated Host header allowlist - the name(s) users type. Required in
# production, no wildcards.
DSPM_TRUSTED_HOSTS=dspm.example.com

# Comma-separated origins allowed to call the API cross-origin with credentials. The
# console is served by the backend itself and needs none: leave this UNSET in
# production (the development default is the localhost console ports). If a separate
# portal must call the API, list its https:// origin.
# DSPM_CORS_ORIGINS=

# Production refuses to serve on anything but loopback, because the backend has no
# TLS. Set 1 only when TLS ends on another host that alone can reach this one.
DSPM_ALLOW_EXTERNAL_BIND=

# Machine-to-machine API keys, formatted tenant_id:hash
DSPM_API_KEYS=

# M13: hard cap (bytes) on request body size, enforced at the perimeter before any
# handler parses the body. An oversized Content-Length is refused immediately; a
# chunked/lying flood is aborted at the cap in bounded memory. Default 25 MB (all
# API bodies are small JSON; no uploads). 0 disables the limit.
DSPM_MAX_BODY_BYTES=26214400

# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------
# All default under ./data. In a container these MUST be on a persistent volume:
# the SQLite DB also backs login rate limiting, so an ephemeral filesystem
# silently resets brute-force protection on every restart.
DSPM_DB_PATH=data/dspm.sqlite
# Phase 2 (roadmap M2): opt in to PostgreSQL for the primary store (credential
# hashes, API keys, encrypted vault, login throttle). Leave EMPTY to use the
# SQLite file above (the default). When set to a libpq DSN/URL the store runs on
# Postgres instead - off-host, least-privilege, TLS, encrypted-at-rest. Requires
# `pip install -r requirements-postgres.txt`. Always pin sslmode in production.
# Example: postgresql://sentro_app:CHANGE_ME@127.0.0.1:5432/sentro_dev?sslmode=require
DSPM_DB_URL=
# Connection timeout (seconds) for the Postgres backend; ignored for SQLite.
DSPM_DB_CONNECT_TIMEOUT=10
# Phase 0 (DB-01): pin THIS deployment to one database. When set, startup
# refuses to serve unless the connected identity matches. Find the value in
# /api/health -> database.identity (PostgreSQL: <system_identifier>/<dbname>).
# Production additionally refuses SQLite outright regardless of this setting.
DSPM_DB_EXPECTED_IDENTITY=

# Phase 1 (DB-02): encrypted database backups. The backup key is a Fernet key
# DISTINCT from the vault key - a backup escaping the host must not also
# unlock stored scan credentials. Required in production; local dev generates
# one at ~/.dspm/backup_key. Age of the newest backup is exposed in
# /api/health -> database.backup_age_seconds.
DSPM_BACKUP_KEY=
DSPM_BACKUP_DIR=data/backups
DSPM_LOCAL_BACKUP_KEY_PATH=
# Role used for pg_dump (must read every table; the runtime role must not).
DSPM_BACKUP_DB_URL=
# PostgreSQL client tools directory (pg_dump/pg_restore).
DSPM_PG_BIN=
# Postgres connection pool (Track S-A) - reuses connections so queries don't pay
# a TCP+scram handshake each time. Requires psycopg_pool (requirements-postgres.txt);
# ignored for SQLite and if psycopg_pool is absent (falls back to connect-per-op).
DSPM_DB_POOL_MIN=1
DSPM_DB_POOL_MAX=10
DSPM_DB_POOL_MAX_IDLE=300
# "1" (default) validates a pooled connection on checkout so a connection killed
# by a Postgres restart/failover is replaced instead of failing the next query
# (~1 round-trip/checkout). Set "0" for max throughput.
DSPM_DB_POOL_CHECK=1
# Test-only safety switch. The pytest suite TRUNCATES the target Postgres DB for
# per-test isolation; it refuses to run against Postgres unless this is 1, so a
# persistent/production DSPM_DB_URL can't be wiped by an accidental test run.
# NEVER set this against a production database. Unset for the SQLite default.
DSPM_PG_TEST_RESET=
# PostgreSQL provisioning (scripts/provision_postgres.py) - creates the app
# database + least-privilege role. These are used by the provisioning CLI only,
# not the running app. DSPM_PG_ADMIN_URL is how the tool connects as an admin
# (superuser or CREATEDB+CREATEROLE); the rest shape the created role and the
# emitted DSPM_DB_URL. Leave blank to pass them on the command line instead.
DSPM_PG_ADMIN_URL=
DSPM_PG_DB=sentro_dev
DSPM_PG_APP_ROLE=sentro_app
DSPM_PG_APP_PASSWORD=
DSPM_PG_HOST=127.0.0.1
DSPM_PG_PORT=5432
DSPM_PG_SSLMODE=
DSPM_REPORT_DIR=data/reports
DSPM_LOCAL_VAULT_KEY_PATH=
# M1 (Phase 1.1): dev-only key files, kept OUTSIDE data/ so a data/ backup never
# carries auth/evidence key material. Default ~/.dspm/. In production the keys
# come from DSPM_SECRET_KEY / DSPM_EVIDENCE_HMAC_KEY (env) and no file is written.
DSPM_LOCAL_JWT_SECRET_PATH=
DSPM_LOCAL_EVIDENCE_KEY_PATH=

# Phase 1 read-switch (DATA-001). "1" serves list_findings from the normalized
# finding_index instead of loading report blobs; "0" (default) uses the blob.
# Parity-tested; any error falls back to the blob path automatically.
DSPM_READ_FROM_NORMALIZED=0
# S-C/S-D/S-E inventory read-switch. "1" serves cursor pages, indexed search,
# protected/finding/multi-framework filters, facets, and on-demand row detail from
# normalized assets; "0" forces the compatible blob fallback. Indexed reads are
# the default for a complete mirror; migrated/incomplete databases automatically
# remain on fallback until the backfill finishes. The console
# itself always keeps a bounded page window and requests compact history payloads.
# Run backfill_normalized_scans before enabling on a migrated DB; the readiness
# gate keeps fallback active until S-E detail rows have been populated.
DSPM_INVENTORY_FROM_NORMALIZED=1

# Emergency escape hatch (Phase 5). Normalized scan writes are authoritative:
# a scan whose assets/findings cannot be written fails the save. Set to 1 to
# restore the pre-Phase-5 best-effort mirror, knowingly accepting an estate
# that is missing that scan. Leave unset in production.
DSPM_NORMALIZED_WRITE_BEST_EFFORT=0

# Artifact tier (Phase 5). Scan report bodies are stored as immutable,
# gzip-compressed, encrypted, content-addressed objects instead of database
# rows; the row keeps the reference. Set DSPM_REPORT_ARTIFACTS=0 to keep
# bodies inline (pre-Phase-5 behaviour).
#
# IMPORTANT: DSPM_ARTIFACT_KEY belongs in the recovery inventory alongside the
# vault and backup keys. A database restore without it recovers metadata and
# no report bodies. Required in production; development generates a local
# keyfile outside data/.
DSPM_REPORT_ARTIFACTS=1
# DSPM_ARTIFACT_KEY=
DSPM_ARTIFACT_DIR=data/artifacts
# DSPM_LOCAL_ARTIFACT_KEY_PATH=~/.dspm/artifact_key

# --- Operations (Phase 6) -------------------------------------------------
# Backup staleness threshold. /api/ready and /api/admin/db-metrics warn when
# the newest backup is older than this; neither takes the instance out of
# rotation for it.
DSPM_BACKUP_MAX_AGE_HOURS=26
# Mean execution time above which /api/admin/db-slow-queries counts a
# statement as worth reviewing.
DSPM_SLOW_QUERY_MEAN_MS=250
# Directory whose volume is measured for disk headroom (defaults to data/).
DSPM_DATA_DIR=data

# --- Scale / regulated tier certification (Phase 7) ------------------------
# Aggregate-only database activity counters. Query text, clients, roles and
# tenant identifiers are never emitted. Enable only where the approved customer
# profile requires database activity monitoring; REQUIRED makes metrics warn if
# the collector is off.
DSPM_DB_ACTIVITY_MONITORING=0
DSPM_DB_ACTIVITY_MONITORING_REQUIRED=0
# Optional HMAC key for the manifest inside a Phase 7 evidence ZIP. Keep it in
# the approved secret store; never commit it or pass it on the command line.
DSPM_DB_EVIDENCE_SIGNING_KEY=

# --- Tooling-only (not application configuration) -------------------------
# DSPM_MIGRATE_DEST_URL: destination DSN for
#   scripts/migrate_sqlite_to_postgres.py, when it should differ from
#   DSPM_DB_URL. Set for the duration of the migration only.
# DSPM_MIGRATIONS_CLI=1 is set BY `python -m backend.migrations` itself so
#   importing the store stays inert; never set it for the application.
# Reuse a capped filtered total across cursor pages (0 disables, maximum 60s).
# Authoritative scan saves/backfills invalidate the cache immediately.
DSPM_INVENTORY_COUNT_CACHE_SECONDS=5

# S-G streaming inventory export. Rows are fetched with an id keyset in bounded
# database batches and encoded into ~64 KiB response chunks. Accepted range is
# 10-5000; invalid values use 1000. Export never falls back to report blobs.
DSPM_EXPORT_BATCH_SIZE=1000
# Test/benchmark-only destructive opt-in for scripts/inventory_benchmark.py.
# The target database name must also contain "test" or "bench". Never set this
# in an application service or against production.
DSPM_INVENTORY_BENCHMARK_ALLOW_WRITE=

# S-F optional dedicated fuzzy/typo-tolerant search valve. PostgreSQL remains
# authoritative and the default. To stage Meilisearch safely: configure the
# engine/URL/key with READ_ENABLED=0, rebuild the index, verify /api/health, then
# set READ_ENABLED=1. Only text queries (q=...) use it; any error falls back to
# the existing database inventory. Keep the API key out of command arguments.
DSPM_SEARCH_ENGINE=database
DSPM_MEILISEARCH_URL=
DSPM_MEILISEARCH_API_KEY=
DSPM_MEILISEARCH_INDEX=sentro_assets_v1
DSPM_SEARCH_DUAL_WRITE=1
DSPM_SEARCH_READ_ENABLED=0
DSPM_SEARCH_TIMEOUT_SECONDS=2
DSPM_SEARCH_BATCH_SIZE=500
# S-F.2 bounded automated drift reconciliation. Set seconds to 0 to disable.
# Repair mode upserts missing/stale metadata and removes search-only documents.
DSPM_SEARCH_RECONCILE_SECONDS=300
DSPM_SEARCH_RECONCILE_REPAIR=1
# Test/benchmark-only opt-ins (unset in normal operation): point the live
# Meilisearch parity suite at a running engine, and allow the capacity benchmark
# to write into a disposable test/bench database.
DSPM_MEILISEARCH_LIVE_URL=
DSPM_MEILISEARCH_LIVE_KEY=
DSPM_SEARCH_BENCHMARK_ALLOW_WRITE=

# -----------------------------------------------------------------------------
# Evidence integrity
# -----------------------------------------------------------------------------
# HMAC key for evidence fingerprints (SC-2, implemented). Production is now
# fail-closed: fingerprint generation raises if this is unset. In local/dev a
# per-install key is generated and persisted OUTSIDE data/ (default
# ~/.dspm/evidence_hmac_key, see DSPM_LOCAL_EVIDENCE_KEY_PATH). Set it explicitly
# in production.
DSPM_EVIDENCE_HMAC_KEY=


# -----------------------------------------------------------------------------
# Scanning safety
# -----------------------------------------------------------------------------
# Require TLS for WinRM (SC-7). When unset, SSL is now required in production
# and cleartext HTTP 5985 + NTLM is tolerated only in local/dev. Set explicitly
# to "1" to always require SSL, or "0" to explicitly allow HTTP even in prod.
# NOTE: the endpoint-scan API currently only reaches HTTP, so requiring SSL in
# production fails those scans closed until an HTTPS endpoint is configured.
DSPM_REQUIRE_WINRM_SSL=1

# Allow WinRM auto-activation in production (SC-7). Activation opens a listener
# + firewall and enables DCOM/WMI on the target, so it is disabled in production
# by default. Set to 1 only for an explicit, audited admin workflow. As of 0.3
# activation no longer sets LocalAccountTokenFilterPolicy, scopes the firewall to
# Domain/Private + the collector, and pins the WinRM source filter.
DSPM_ALLOW_WINRM_ACTIVATION=0

# 0.3 (M10/M11), all default-off and requiring a live-target validation (runbook):
# Provision an HTTPS(5986) listener with a cert instead of HTTP(5985) on activation.
DSPM_WINRM_ACTIVATION_HTTPS=0
# Prefer Kerberos (mutual auth, not NTLM-relayable) for the scan session, NTLM fallback.
DSPM_WINRM_KERBEROS=0
# Skip WinRM TLS cert validation - ONLY for a self-signed activation cert on a
# trusted internal network. Default 0 (validate). Prefer cert pinning / CA trust.
DSPM_WINRM_SSL_SKIP_CA_CHECK=0

# C5: what may be scanned is no longer an install-wide switch. Each workspace lists
# the networks (10.20.0.0/16, an address) and host names (fs01.corp.example,
# *.corp.example) it may scan, under Security operations -> Scan targets; anything
# else is refused before the scan connects, and recorded in the audit trail. With no
# list, production scans nothing on the network and development scans anything but
# loopback, link-local and cloud-metadata addresses (never scannable).
# The old switch is no longer obeyed; /api/ready warns while it is still set:
# DSPM_ALLOW_PRIVATE_TARGETS=

# Wall-clock scan deadline in seconds (default 1800). Enforced (M14): the engine
# polls it in the collection and analysis loops and returns a partial, truncated
# report when exceeded, releasing its worker. 0 disables it.
DSPM_SCAN_MAX_SECONDS=1800
DSPM_SCAN_HEARTBEAT_SECONDS=2
# Track P-B adaptive analysis. 0/blank sizes the bounded pool to logical CPUs
# (hard cap 32). The pipeline overlaps collector output with analysis and applies
# backpressure at the configured record count; 0/blank derives a bounded value.
DSPM_ANALYSIS_WORKERS=0
DSPM_PIPELINE_ENABLED=1
DSPM_PIPELINE_BUFFER=0
# P1 collector I/O. DSPM_IO_WORKERS bounds the parallel-acquisition pool
# a collector may use for listing/download (0/blank = ~2x CPU, hard cap 64).
# DSPM_HOST_IO_BUDGET is a PROCESS-WIDE cap on concurrently connected collector
# workers across ALL scan jobs, so concurrent scans can't oversubscribe one host
# (0/blank = ~2x CPU, hard cap 128). SMB uses a metadata-first, bounded file
# pipeline with isolated per-thread connections. DSPM_SMB_PARALLEL=0 is the full
# legacy escape hatch. DSPM_SMB_FILE_PARALLEL=0 keeps metadata/ACL batching but
# serializes file acquisition. ACLs retain owner, principals, and permissions;
# one PowerShell process handles up to DSPM_SMB_ACL_BATCH_SIZE paths (1..512),
# with an exact per-file fallback if a batch cannot launch or parse.
# P2 streams each remote file once while deriving its bounded content preview,
# full SHA-256, and ZIP inspection buffers. Any failed/short stream retries via
# the original independent readers. Set DSPM_SMB_SINGLE_PASS=0 for exact legacy
# preview/hash/archive acquisition while diagnosing an unusual SMB server.
# DSPM_WINRM_PARALLEL controls the WinRM endpoint scan's IN-SESSION runspace pool
# that parallelizes per-file content/hash/ACL work: ON by default (1); set 0 to
# force the serial single-runspace path. DSPM_WINRM_WORKERS overrides the pool
# size (blank = resolved io_workers, capped at 8 since the pool runs on the
# endpoint whose core count is unknown).
DSPM_IO_WORKERS=0
DSPM_HOST_IO_BUDGET=0
DSPM_SMB_PARALLEL=1
DSPM_SMB_FILE_PARALLEL=1
DSPM_SMB_ACL_BATCH=1
DSPM_SMB_ACL_BATCH_SIZE=32
DSPM_SMB_ACL_BATCH_TIMEOUT_SECONDS=
DSPM_SMB_SINGLE_PASS=1
DSPM_WINRM_PARALLEL=1
DSPM_WINRM_WORKERS=
# P3 endpoint response compression. Scan JSON returns as gzip+base64 over WS-Man;
# the backend refuses decompressed responses above this byte ceiling (default
# 512 MiB, accepted range 1 KiB..2 GiB) before JSON parsing.
DSPM_WINRM_RESPONSE_MAX_BYTES=536870912
# How much text an endpoint scan reads from ONE file (B4). Every byte crosses
# WinRM and is held on both sides; the record says when a file was truncated and
# reports a partial scan of it. 5 MB by default.
DSPM_ENDPOINT_MAX_FILE_TEXT_BYTES=5242880
# How many bytes of file content one endpoint fetch command may ask for. One
# command is one response, held whole on the endpoint and again here. 32 MB.
DSPM_ENDPOINT_FETCH_BATCH_BYTES=33554432
# Track P-E partitioned scanning (discovery.partition.run_partitioned). Splits a
# local scan into per-top-level-subtree units run across worker PROCESSES (true
# past-the-GIL parallelism + concurrent per-file Get-Acl collection, the local
# bottleneck), merged into one report semantically identical to a single scan.
# DSPM_PARTITION_WORKERS bounds the worker-process count (blank/0 = ~CPU-1). This
# is an opt-in runner used by callers of run_partitioned; the default job path is
# unchanged.
DSPM_PARTITION_WORKERS=
# Enforced wall-clock budget (seconds) for processing a single archive (M9),
# cooperative between entries. Default 30.
DSPM_ARCHIVE_TIMEOUT_SECONDS=30
DSPM_TEXT_SCAN_MAX_BYTES=
# Track P-C triage. Before the detector catalog runs, a cheap pass skips content
# that is unambiguously binary (a NUL byte in the sampled head - git's binary
# rule): compressed/encrypted/binary data mislabeled with a text extension holds
# no plaintext the detectors could match, so this is recall-safe and consistent
# with never reading binary-extension content. Text in ANY encoding (incl.
# non-UTF-8 Azerbaijani/Turkish/German) has no NUL and is always fully scanned.
# DSPM_TRIAGE_ENABLED=0 turns triage off; DSPM_TRIAGE_BINARY_SKIP=0 keeps the
# score/diagnostics but never skips. DSPM_TRIAGE_ORDER (default on) analyzes
# higher-sensitivity files first so a deadline-truncated scan keeps recall on what
# matters (never changes a completed scan's output). DSPM_TRIAGE_SAMPLE_BYTES>0
# opts into head/tail sampling of text longer than that many chars (marks the
# result PARTIAL/truncated) - a bounded-recall speed lever for very large files;
# 0 (default) scans full content.
DSPM_TRIAGE_ENABLED=1
DSPM_TRIAGE_BINARY_SKIP=1
DSPM_TRIAGE_ORDER=1
DSPM_TRIAGE_SAMPLE_BYTES=0
# Track P-D detector throughput. The generic catalog runs one regex pass per rule;
# the prefilter skips any rule whose mandatory literal (e.g. "AKIA", "BEGIN PRIVATE
# KEY", "password") is absent from the content - recall-exact, since a skipped rule
# would have produced zero matches. The four numeric rules (card/IBAN/FIN/phone)
# have no fixed literal and always run. DSPM_DETECTOR_PREFILTER=0 runs every rule.
DSPM_DETECTOR_PREFILTER=1
# Entity recognition (optional, OFF by default). Requires the optional extra:
# pip install -r requirements-ml.txt && python -m spacy download en_core_web_sm.
# When "1", spaCy NER counts PERSON/ORG/GPE/DATE/CARDINAL entities per file and
# emits them as LOW-severity, LOW-confidence hints that do NOT drive severity or
# posture - every business document contains a DATE and a CARDINAL, so this is a
# tuning surface, not a detector. The heuristic keyword "classifier" that used to
# stand in for this when spaCy was absent has been removed: it made one
# occurrence of "tax", "bank", "employee" or "patient" a MEDIUM or HIGH finding.
# Toggling this invalidates the findings cache and forces a full re-classify (it
# is folded into the scan version signature).
DSPM_ML_NER_ENABLED=0

# -----------------------------------------------------------------------------
# OCR (optional) - text extraction from images / scanned documents
# -----------------------------------------------------------------------------
# OFF by default. Requires the optional extra: pip install -r requirements-ocr.txt
# (RapidOCR / ONNX Runtime; ~150 MB, ~2 s/image on CPU). When "1", scans OCR
# image files (.png/.jpg/.jpeg/.tif/.tiff/.bmp) on LOCAL and SMB targets and feed
# the text into the classifiers (SC-1 masking still applies). WinRM targets do
# not OCR (extraction runs remotely in PowerShell). If the dependency is missing
# while enabled, OCR is skipped with a warning - scans are never broken.
DSPM_OCR_ENABLED=0
# Hardening bounds for UNTRUSTED images (all have safe defaults):
#   file-size cap (bytes) - images larger than this are skipped.
DSPM_OCR_MAX_FILE_BYTES=26214400
#   decompression-bomb cap (pixels) - rejected from the header, before full decode.
DSPM_OCR_MAX_PIXELS=40000000
#   longest side is downscaled to this before OCR (bounds CPU/RAM and OCR time).
DSPM_OCR_MAX_DIMENSION=2600
#   per-image wall-clock budget (seconds); a slower inference is abandoned.
DSPM_OCR_TIMEOUT_SECONDS=20
#   drop OCR lines below this confidence (0-1) as noise.
DSPM_OCR_MIN_CONFIDENCE=0.3
#   cap on extracted characters per image.
DSPM_OCR_MAX_CHARS=120000
#   ONNX Runtime intra-op threads; 0 = library default (recommended).
DSPM_OCR_INTRA_OP_THREADS=0
#   Result cache: max images remembered by content hash so an UNCHANGED image is
#   never re-OCR'd (identical bytes -> identical text; accuracy unaffected). This
#   is the main speedup for repeat scans. 0 disables the cache.
DSPM_OCR_CACHE_MAX=1024

# -----------------------------------------------------------------------------
# Authentication tuning
# -----------------------------------------------------------------------------
# C1: the life of an ACCESS token, in seconds. Bounded to half an hour: an access
# token is a bearer credential, and whoever lifts one from a browser, a proxy log
# or a crash dump holds the account until it expires. The console renews it
# silently through the refresh cookie, so a shorter value costs nothing visible.
DSPM_TOKEN_TTL_SECONDS=1800
# C1: how long a signed-in session lasts - the life of the single-use refresh
# token (HttpOnly cookie) that carries it. Each renewal retires the token used;
# presenting a retired one ends every session in that chain.
DSPM_REFRESH_TOKEN_TTL_SECONDS=28800
# C1: live sessions one account may hold; the oldest past it are revoked. 0 = no cap.
DSPM_MAX_SESSIONS_PER_USER=16
DSPM_LOGIN_MAX_ATTEMPTS=5
DSPM_LOGIN_WINDOW_SECONDS=300
# M4: aggregate per-IP failure cap (across ALL usernames) in the same window, so
# one IP spraying a password across many usernames is throttled even when no single
# (IP,username) counter trips. Higher than the per-user cap for shared NAT/office IPs.
DSPM_LOGIN_IP_MAX_ATTEMPTS=30
# C4/C5: reverse proxies whose X-Forwarded-For (and X-Forwarded-Proto) is believed, as a
# comma-separated list of addresses or networks (e.g. 10.0.0.5,10.0.1.0/24). Audit rows
# and per-address throttles then name the client the proxy saw. Empty: the headers are
# ignored and the peer's own address is used - right for a console reached directly.
# In production behind the same-host proxy this is 127.0.0.1, and production refuses
# to serve on loopback without it. `main.py serve` turns off uvicorn's own forwarded-
# header handling, which would otherwise believe 127.0.0.1 whatever this says.
DSPM_TRUSTED_PROXIES=127.0.0.1

# C4: forwarding audit events to a SIEM is configured in the console - Settings ->
# Features -> SIEM Integration - and kept in the database, so every backend follows it
# without a restart. These three are read ONCE, as the starting configuration of an
# install that has none (tcp://host:514, udp://host:514 or tls://host:6514; cef or json;
# a PEM CA file for a private CA). After that the console decides, and removing the
# configuration there does not bring these back.
DSPM_SIEM_URL=
DSPM_SIEM_FORMAT=cef
DSPM_SIEM_CA_FILE=
# How often the forwarder looks for due events (seconds).
DSPM_SIEM_INTERVAL_SECONDS=2
# C4: how often a workspace's audit trail may be verified from the console
# (GET /api/audit/verify) in an hour. Each check reads the whole trail.
DSPM_AUDIT_VERIFY_MAX_PER_HOUR=20
# C8: the other routes that answer a guess, each counted on its own key.
# Wrong current password on Change password, per ACCOUNT, in 15 minutes:
DSPM_PASSWORD_CHANGE_MAX_FAILURES=5
# Refused registrations (unknown tenant, wrong code, taken name), per address, in an hour:
DSPM_REGISTER_MAX_FAILURES=10
# Refused session renewals (expired, unknown or replayed cookie), per address, in 5 minutes:
DSPM_REFRESH_MAX_FAILURES=30
# C8: PBKDF2-HMAC-SHA256 rounds for NEW password hashes. Default 600000; clamped to
# 210000-1200000. Existing hashes made with fewer rounds are upgraded silently at the
# user's next successful sign-in - no reset, no sign-out.
DSPM_PBKDF2_ROUNDS=
# C8: minimum length of a NEW password. Default 12; may be raised, never set below 8.
# New passwords are also refused if common or breached, mostly one repeated
# character, or containing the username. Existing passwords keep working.
DSPM_PASSWORD_MIN_LENGTH=12
# C8: optional offline breached-password list - a SORTED file of SHA-1 hashes, one
# per line, optionally followed by ":count" (the "Pwned Passwords" download ordered
# by hash). Searched on disk, never loaded into memory. Unset: a built-in list of
# common passwords still applies.
DSPM_BREACHED_PASSWORDS_FILE=
# M3: DSPM_VAULT_KDF_ROUNDS and DSPM_VAULT_SALT are removed - the vault now uses a
# real Fernet key directly (DSPM_VAULT_KEY), with no key derivation.
# C12: the vault's versioned key ring - a FILE holding keys (protect it like one:
# Administrators and the services only). `python main.py vault rotate` creates it from
# DSPM_VAULT_KEY the first time; from then on it holds every key a saved credential
# names, and rotation, rollback and escrow work on it. Unset: the single key above.
DSPM_VAULT_KEYRING=
# C12: the recommended interval, in days, between password changes of a saved scan
# credential. A reminder in Settings -> Security, never an enforcement. Default 90.
DSPM_CREDENTIAL_ROTATION_DAYS=90
# C13: how many values one account may reveal in an hour (successful or refused).
DSPM_REVEAL_MAX_PER_HOUR=20

# How long a session may go unused before it stops working. An 8-hour session with
# no idle timeout means a console left open on an unlocked machine in the morning is
# still signed in at the end of the day. C1: last-seen is held in the database
# (user_sessions), so the timeout survives a restart and is shared by every worker;
# the write is throttled (DSPM_SESSION_TOUCH_SECONDS, never more than a quarter of
# this window). An expired session is REVOKED, not merely refused. 0 disables.
DSPM_SESSION_IDLE_SECONDS=3600
DSPM_SESSION_TOUCH_SECONDS=60

# C2: two-step sign-in (TOTP authenticator apps; no SMS, e-mail or cloud service).
# Administrators set one up at their first sign-in; credential managers when they
# first store a credential. Wrong codes, per ACCOUNT, in 15 minutes, before the
# account's code step refuses for the rest of the window:
DSPM_MFA_MAX_FAILURES=5
# C2: directory sign-in (Settings -> Security, per workspace). How long a directory
# account's groups are trusted before the next session renewal reads them again - the
# bound on how long a removed group or a disabled account keeps its access. Seconds;
# default 900, clamped to 60-3600. If the directory cannot be reached at that renewal,
# the renewal is refused (it fails closed) and the person signs in again once it is back.
DSPM_DIRECTORY_REVALIDATE_SECONDS=900

# C8: accept the one-time artifact download token in the ?dl_token= query string as
# well as the X-Artifact-Token header. OFF: a query string is written to every proxy
# and access log on the path, and the console fetches with the header and shows a
# blob. Only for a non-production browser that refuses blob navigation; production
# ignores it.
DSPM_ALLOW_DL_TOKEN_QUERY=0

# Also write each saved scan report to DSPM_REPORT_DIR as plain JSON, previews
# included. OFF: the encrypted artifact tier (gzip + Fernet, content-addressed,
# in the backup set and covered by tenant erasure) holds the same bodies. Turn
# it on only if an external tool still reads that directory.
DSPM_PLAINTEXT_REPORT_EXPORT=0

# Leave unset/0 in production. Re-syncs the built-in admin password from
# DSPM_ADMIN_PASSWORD at every startup, overwriting any rotation.
DSPM_SYNC_BUILTIN_ADMIN=0

# Leave unset/0. Enables verification of legacy unsalted SHA-256 password hashes.
# C8: each such account is re-hashed to PBKDF2 at its next successful sign-in, so
# turn this on for one sign-in cycle, then off again.
DSPM_ALLOW_LEGACY_SHA256_PASSWORDS=0

# Local-only convenience override. Ignored in production (DSPM_ADMIN_PASSWORD is
# required there). When unset, a local install generates a strong one-time admin
# password and prints it once at startup. Either way the password must meet the
# policy above, or startup stops and says which rule it broke.
DSPM_DEV_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Job queue
# -----------------------------------------------------------------------------
DSPM_JOB_WORKERS=
DSPM_MAX_JOBS_TOTAL=
DSPM_MAX_JOBS_PER_TENANT=
DSPM_MAX_JOB_RESULT_FILES=
DSPM_JOB_RETENTION_SECONDS=

# -----------------------------------------------------------------------------
# Partitioned scans (Phase B, B2)
# -----------------------------------------------------------------------------
# A local scan cut into partitions persists each one as it finishes, so its
# memory follows the largest partition rather than the whole estate. OFF by
# default until the B2 memory gates are measured at scale.
DSPM_PARTITIONED_SCANS=0
# The most files one partition holds - and so what a partitioned scan's memory
# follows. A folder larger than this is split into runs of its entries.
DSPM_PARTITION_MAX_FILES=2000
# How many times one partition is tried before its scan fails. A partition that
# fails is tried again once the rest of the scan has run.
DSPM_PARTITION_MAX_ATTEMPTS=3
# How long a running partition stays its worker's without a renewal (renewed every
# third of this). An interrupted scan is continued once it has been quiet this
# long, so this is also roughly how soon a scan resumes after a restart.
DSPM_PARTITION_LEASE_SECONDS=300
# How often the backend looks for partitioned scans a stopped process left
# unfinished, and continues them. 0 turns resuming off: such a scan then stays
# unfinished, with its finished partitions in the estate and no report.
DSPM_SCAN_RESUME_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Partition workers (Phase B, B3 fundamentals)
# -----------------------------------------------------------------------------
# `python main.py worker` takes partitions straight from the database ledger,
# so several workers can share scans with nothing else installed: claims are
# compare-and-set and leases take back a dead worker's partition. `ledger` is
# the only queue (Memurai was removed; an old `redis` value falls back to it).
DSPM_WORK_QUEUE=ledger
# B3.1: the estate aggregates the console asks for on every refresh - posture
# inputs and inventory facets - are kept in the database's derived_cache table,
# so a second backend or a worker reads one row instead of re-computing them.
# Every estate write moves the tenant's generation, so a scan's result shows at
# once; the TTL only bounds how long an answer may be served. Derived numbers
# only - never content or samples. Set to 0 to compute every read afresh.
DSPM_LIVE_CACHE=1
DSPM_LIVE_CACHE_SECONDS=30
# Who runs the partitions of a scan the console starts: `inline` (the default)
# runs them in the backend process, `queue` publishes them and lets
# `python main.py worker` processes run them. A queue that cannot be reached
# falls back to inline, so a scan is never lost to it.
DSPM_SCAN_EXECUTION=inline
# How long a queued scan's job waits for workers before it reports that none
# finished it. The scan is left alone - a worker may still be running it.
DSPM_SCAN_QUEUE_MAX_SECONDS=86400
# How often the backend looks for scan schedules that have fallen due (B3).
# 0 turns scheduled scans off; a due schedule then simply waits.
DSPM_SCAN_SCHEDULER_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# Housekeeping (Phase B, B5)
# -----------------------------------------------------------------------------
# How often the backend prunes what grows on its own - alert and audit rows past
# their window (DSPM_RETAIN_ALERT_DAYS / DSPM_RETAIN_AUDIT_DAYS) and finished job
# records. A day by default; 0 turns it off and leaves it to
# `python scripts/db_retention.py`. A tenant under legal hold keeps everything.
DSPM_RETENTION_INTERVAL_SECONDS=86400
# Collect artifact objects no row references any more. Off by default: this is
# garbage collection rather than retention, and an install should say yes to it.
DSPM_RETENTION_PRUNE_ARTIFACTS=0
# Delete plaintext scan report files (DSPM_REPORT_DIR) older than this many days.
# 0, the default, keeps them: they are not written any more, but the ones already
# written are somebody's data.
DSPM_RETAIN_REPORT_FILE_DAYS=0

# -----------------------------------------------------------------------------
# Alerting
# -----------------------------------------------------------------------------
# Optional webhook POSTed on CRITICAL findings (backend/alerts.py).
# The variable name is DSPM_ALERT_WEBHOOK_URL - README previously documented
# this as DSPM_WEBHOOK_URL, which the code never reads.
DSPM_ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Report artifacts
# -----------------------------------------------------------------------------
# Lifetime of the signed download token for a generated scan PDF.
DSPM_ARTIFACT_DL_TOKEN_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Detector timeouts / test switches
# -----------------------------------------------------------------------------
DSPM_GDPR_DETECTOR_TIMEOUT_SECONDS=
DSPM_NIST_DETECTOR_TIMEOUT_SECONDS=

# Dev-only: enables large/slow tests. Leave unset in production.
DSPM_RUN_LARGE_TESTS=0

# Dev-only: keep the SQLite test database after a run instead of deleting it.
DSPM_TEST_KEEP_DB=0

# Scans of the bundled synthetic demo dataset (enterprise_test_data) stay
# viewable as scan reports but never enter the durable asset estate, so the
# dashboard and Data Inventory only ever count real customer data. Set to 1
# (dev-only) to let demo scans into the inventory like any other scan.
DSPM_DEMO_ASSETS_IN_INVENTORY=0

# -----------------------------------------------------------------------------
# Tuning knobs the code reads but this file had never documented
# -----------------------------------------------------------------------------
# These all have working defaults; they exist so an operator can tune a specific
# install, and so the CI gate that keeps this file honest can see them.

# Detector process pool. The classifier stage is pure-Python CPU work, so it runs
# in child processes. Warm-up costs ~12s of CPU taken from the cores the scan is
# using, so the pool only starts once the COLLECTOR has passed this many files -
# that way it warms during I/O rather than competing with analysis. 0 disables it.
DSPM_DETECTOR_PROCESSES=
DSPM_DETECTOR_POOL_START_AFTER=96

# How many scans keep their full per-finding response body in `finding_index`.
# Older scans keep their status row, which is what the history views read; the
# response body is what grew that table to a third of the database.
DSPM_FINDING_INDEX_KEEP_SCANS=5

# Minimum JSON size (bytes) before a stored column is zlib-compressed. Below this
# the compression costs more than it saves, and '{}' MUST stay literal text -
# two partial indexes and the read-model gate compare it.
DSPM_JSON_COMPRESS_MIN=2048

# Pages of a scan report's inventory projection held in memory per process.
DSPM_SCAN_REPORT_ROWS_CACHE=4

# SQLite journal mode. "wal" is the default and the right answer on local disk;
# a data directory on SMB/NFS must set "delete" - WAL needs working file locking.
DSPM_SQLITE_JOURNAL_MODE=wal

# A server (and a queue worker) holds one idle connection to the database for its
# whole life, so a request's own connection is never the last to close - on WAL the
# last close checkpoints and deletes the WAL, which was half of what an
# authenticated request cost. 0 turns it off. The WAL therefore persists while the
# server runs; after a checkpoint it is truncated back to this size.
DSPM_SQLITE_HOLD_OPEN=1
DSPM_SQLITE_WAL_LIMIT_MB=64

# Per-process caches (seconds). Each trades staleness for query volume, and each
# is PER PROCESS. The revocation cache remembers only tokens found REVOKED (C1), so
# a sign-out or password change on one backend is refused by every other at once.
DSPM_TOKEN_REVOCATION_CACHE_SECONDS=30
DSPM_TENANT_EXISTS_CACHE_SECONDS=30
DSPM_READINESS_CACHE_SECONDS=60
DSPM_INVENTORY_FACETS_CACHE_SECONDS=30

# Where the incremental findings cache lives. Defaults to data/scan_cache;
# point it elsewhere to put it on a different disk. The test suite sets it to
# a temp directory so a test run never reads or writes the install's cache.
DSPM_SCAN_CACHE_DIR=

# scripts/migrate_sqlite_to_postgres.py destination DSN. Falls back to DSPM_DB_URL.
DSPM_MIGRATE_DEST_URL=
